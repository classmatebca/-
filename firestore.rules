rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function approved() {
      return myProfileExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function hasAdminMarker() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return hasAdminMarker()
        && approved()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admin markers are provisioned only from the Firebase Console/Admin SDK.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Students can create only their own pending member profile.
      // A pre-authorized admin marker permits only that same UID to bootstrap
      // its own approved admin profile on first login.
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          (request.resource.data.status == 'pending'
            && request.resource.data.role == 'member')
          ||
          (hasAdminMarker()
            && request.resource.data.status == 'approved'
            && request.resource.data.role == 'admin')
        );

      // Admins can change only another user's approval status.
      allow update: if isAdmin()
        && uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['approved', 'declined'];

      allow delete: if false;
    }

    // Approved members can read the aggregate count; only admins can update it.
    match /stats/{id} {
      allow read: if approved() && id == 'members';
      allow create, update: if isAdmin() && id == 'members';
      allow delete: if false;
    }

    match /notes/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.link is string
        && request.resource.data.link.matches('^https?://.+');
      allow delete: if approved()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /requests/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120;
      allow update: if approved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voters'])
        && request.resource.data.voters.size() == resource.data.voters.size() + 1
        && request.auth.uid in request.resource.data.voters;
      allow delete: if approved()
        && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /messages/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow delete: if isAdmin();
    }
  }
}